@WAIT_LEVEL:
 2080  IF  INKEY$ ="" THEN  GOTO @WAIT_LEVEL
 2090  LET V= CODE  INKEY$ -28
 2100  IF V<1 OR V>5 THEN  GOTO @WAIT_LEVEL
 
# V has level 1 to 5
 2105  CLS 

# store 256*(5-level)+1 at DELAY_LEVEL
 2110  POKE 18767,1
 2120  POKE 18767+1,5-V

 2130  LET F=50*V
 2150  FOR N=1 TO 5
 2160  LET A=18354-1+N
 2170  POKE A,0                     # 0=nop
 2180  IF N<=V THEN  POKE A,25      # 25=add hl,de
 2190  NEXT N
 2200  RETURN 

 3000  SAVE "ATTAC%K"
 3100  GOTO 30

