X("Identifier", Identifier)
X("Float", Float)
X("Integer", Integer)
X("StringLiteral", StringLiteral)
X("CharConstant", CharConstant)
X("LabelRefLine", LabelRefLine)
X("LabelRefAddr", LabelRefAddr)
